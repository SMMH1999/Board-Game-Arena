{
  "manifest_version": 3,
  "name": "Splendor Table Reader",
  "version": "0.8.0",
  "description": "Read the displayed Splendor board on demand and export a local JSON snapshot.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "archive.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
